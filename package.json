{
  "name": "yugioh-mcp",
  "version": "1.0.0",
  "description": "MCP server for YGOPRODeck, Yu Gi Oh! cards, archetypes, and banlists.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/yugioh-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/yugioh-mcp.git"
  },
  "bin": {
    "yugioh-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
